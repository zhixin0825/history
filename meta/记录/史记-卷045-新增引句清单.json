    "note_anchor": "note-1",
    "placement_anchor": "sj045-cite-086",
    "number": 1,
    "source_path": "sources/摘录/史记-卷045-韩世家.md",
    "source_anchor": "p031",
    "quote": "二十二年，秦昭王卒。",
    "reused_existing_quote": false
  },
  {
    "path": "years/bce-0300-0201/bce-0249.md",
    "note_anchor": "note-2",
    "placement_anchor": "sj045-cite-087",
    "number": 2,
    "source_path": "sources/摘录/史记-卷045-韩世家.md",
    "source_anchor": "p031",

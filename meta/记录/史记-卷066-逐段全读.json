        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "29072c0315a580361722811f19ed36dbd6c6abad0b3089cc74177b22bcc25f5f",
        "focus_and_disposition": "宋郑晋吴连续流亡、郑定公与子产时序冲突、昭关地望、百金剑/五万石/执珪、乞食与求见王；古注悬赏爵制分层。"
      },
      {
        "anchor": "p6",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P007"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "45b02d32bc630e2bdcd03ce802eac22cb238a283b7be2b77fcd47b76a89263a6",
        "focus_and_disposition": "争桑两女、钟离居巢、伐楚私仇与荐专诸耕野；同吴世家及左传荐举叙次互校。"
      },
      {
        "anchor": "p7",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P008"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "66c0da055a1fd4c48314bc53a4b97b0a4b3863c05000fdaa019de7fa34591714",
        "focus_and_disposition": "五年而平王卒、昭王轸珍异名、趁丧伐楚、两公子、刺僚及行人任命；516与515分开。"
      },
      {
        "anchor": "p8",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P009"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "f219d5932dd09e7670b1ac7d4adadab9c0e23651b04049379b7104d8961cb2bc",
        "focus_and_disposition": "郤宛伯州犁死亡并举非同年，伯嚭身份、两公子奔楚地及舒之战异说，孙武劝止攻郢。"
      },
      {
        "anchor": "p9",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P010"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "696806523ffafcb4d631ce8375cc5a1df2095adbe96d57dd0f4ecd9005717a56",
        "focus_and_disposition": "六灊、越、豫章三战年序；公子囊瓦据集解索隐应作公孙、子常姓名不误为两人。"
      },
      {
        "anchor": "p10",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P011"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "f628d228dac8ed4d0a401bcfbf5f7b36527c5b354863030055a0d1299dfdd8e0",
        "focus_and_disposition": "阖闾九年联唐蔡、夫概五千、五战至郢；主TXT日期与败走语序对照注本，不改原字而按事序编年。"
      },
      {
        "anchor": "p11",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P012"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "d7a30153e5ac95c8a6934c5d7e3f8f50ff4b1808b72fbe18ba1463c413cc17b2",
        "focus_and_disposition": "昭王逃云梦鄖随、鄖公与怀、王子綦代王、占卜不吉及随不与吴；古注与经传人名区别。"
      },
      {
        "anchor": "p12",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P013"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "7f3d483bc45395c27c2702a037c4add57cf28595f94b53eb50c409aca8451b52",
        "focus_and_disposition": "覆楚/复楚、鞭尸/鞭墓、日暮途远、乞秦七日、五百乘、稷战夫概自立及返郢；506与505和现代研究范围分清。"
      },
      {
        "anchor": "p13",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P014"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "b6cafca1f07aea518692971703f14225605b823632b07672b6c54aec7f58c0ee",
        "focus_and_disposition": "番地、夫差/终累、迁鄀及吴功业总述；不把概括西北南战绩全压504。"
      },
      {
        "anchor": "p14",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P015"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "3924ce7d8b72a07d5bba242173bdbb20091cc324d7eb10d34645947de6080f8a",
        "focus_and_disposition": "孔子相鲁相对四年孤句；不可接前后五年连续加算，沿既有鲁国主线互校。"
      },
      {
        "anchor": "p15",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P016"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "cde69535768de73501f8cda6f93fe2c49a31dd6cac64fab014e432377a13cf1e",
        "focus_and_disposition": "姑苏/檇李正义校语、夫湫/夫椒、脚趾伤、遗命、夫差练兵及会稽议和；文种不是大夫姓种。"
      },
      {
        "anchor": "p16",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P017"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "a05a22854516250d26c6e913c60c1e54f320a81595c5d33db184eb371ce6413b",
        "focus_and_disposition": "勾践食不重味、吊死问疾、齐景公死后局势与艾陵；与下一段四年承接冲突，不重复大战。"
      },
      {
        "anchor": "p17",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P018"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "43cc192a6f4a69e75eb045b4ecf897bcc0d65c5cf2df28c9a577c5326ed6b95e",
        "focus_and_disposition": "子贡谋越、越赂伯嚭、盘庚引语、伍员寄子与鲍牧487年死冲突；鲍氏共同项不证明牧仍在世。"
      },
      {
        "anchor": "p18",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P019"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "ac5fbfc36fbc9073e61c172c6da82cec5453d43b61c89019b91a1ced98145bb8",
        "focus_and_disposition": "伯嚭全部谗辞、属镂、伍员拥立自述、梓木抉眼遗嘱、革囊及祠胥山；移庙潮神等后出注与死年事件分层。"
      },
      {
        "anchor": "p19",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P020"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "a09fab7babd8160b9f88c720a9afdfdf557472d75a31f22614e1b15d76221de6",
        "focus_and_disposition": "悼公阳生同人误分、橐皋鲁卫互见、黄池太子死获异叙、灭吴夫差及伯嚭473/471矛盾；多段分年。"
      },
      {
        "anchor": "p20",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P021"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "54d346831f35d21f2b45a9770fff12295035afeaa7a9619581747ae8504140c2",
        "focus_and_disposition": "白公胜归楚召者惠王/子西、鄢/巢、叶公反对与三年年距；不从概数推日月。"
      },
      {
        "anchor": "p21",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P022"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "b85897134bcbde3d754d92f30b49f56094cd18c3972555dee4d4e98cb1a76aa8",
        "focus_and_disposition": "白公求伐郑、晋攻郑、子西救郑及盟、亲磨剑和卵喻；五年及随后四年按现有487/483/479线对读。"
      },
      {
        "anchor": "p22",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P023"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "4df7418cf0583e6a285d255809953221d39ebad1872962c544f28504cb658486",
        "focus_and_disposition": "白公石乞袭朝、子綦/子期、救王从者歧文与圉公阳、叶公反攻、白公自杀及石乞不告受烹全段。"
      },
      {
        "anchor": "p23",
        "source_path": "sources/史记三家注/卷066.md",
        "linked_units": [
          "P024"
        ],
        "read_status": "full_paragraph_and_all_commentary_read",
        "raw_sha256": "85edf57d5bca4c82c7456fca3d8ed1f58092b777f40a960042465068199a91cb",
        "focus_and_disposition": "怨毒、弃小义雪大耻、乞食不忘郢与白公反事实论赞；不变成亲历事件或白公已称王。"
      },
      {
